# LA VAGUE Backend Environment Variables

# Server
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Paystack
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here

# ==========================================
# EMAIL CONFIGURATION
# ==========================================

# Provider: smtp, gmail, sendgrid, brevo, or sendinblue
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@la-vague.store
SMTP_FROM_NAME=LA VAGUE
EMAIL_TEST_MODE=false

# Generic SMTP / Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Brevo API (preferred when EMAIL_PROVIDER=brevo)
BREVO_API_KEY=your-enabled-brevo-api-key

# Brevo SMTP fallback
BREVO_USER=your-brevo-login@example.com
BREVO_PASS=your-brevo-smtp-key

# SendGrid SMTP
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# ==========================================
# ADMIN CONFIGURATION
# ==========================================

ADMIN_PASSWORD=your-secure-admin-password-here

# ==========================================
# DATABASE CONFIGURATION
# ==========================================

# Local development defaults to SQLite when DATABASE_URL is not set.
# Production uses PostgreSQL.
# DATABASE_URL=postgresql://user:password@host:port/database

# PostgreSQL TLS controls
# PG_SSL=true
# PG_SSL_REJECT_UNAUTHORIZED=true

# ==========================================
# MEDIA / CLOUDINARY
# ==========================================

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ==========================================
# ERROR TRACKING
# ==========================================

SENTRY_DSN=https://your-sentry-dsn-here@o0.ingest.sentry.io/0
# SENTRY_FRONTEND_DSN=https://your-frontend-dsn@o0.ingest.sentry.io/0
# RELEASE=1.1.0
